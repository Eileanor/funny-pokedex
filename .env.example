# Copy to .env and adjust values as needed before running docker compose

SERVER_PORT=5000
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=INFO

# Redis (service name must match the docker-compose service when running in compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=5s

# Upstream clients
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
FUNTRANSLATIONS_BASE_URL=https://api.funtranslations.mercxry.me/v1/translate
FUNTRANSLATIONS_SHAKESPEARE_PATH=/shakespeare
FUNTRANSLATIONS_YODA_PATH=/yoda

# Cache
CACHE_TTL=24h
CACHE_NAME_POKEMON=pokemon
CACHE_NAME_POKEMON_TRANSLATED=pokemon-translated

# Inbound rate limiter
RATE_LIMIT_FOR_PERIOD=20
RATE_LIMIT_REFRESH_PERIOD=1m
RATE_LIMIT_TIMEOUT=0

# PokeAPI Resilience4j
POKEAPI_RETRY_MAX_ATTEMPTS=3
POKEAPI_RETRY_WAIT=500ms
POKEAPI_CB_SLIDING_WINDOW_SIZE=10
POKEAPI_CB_FAILURE_RATE_THRESHOLD=50
POKEAPI_CB_WAIT_OPEN=30s

# FunTranslations Resilience4j
FUNTRANSLATIONS_RETRY_MAX_ATTEMPTS=3
FUNTRANSLATIONS_RETRY_WAIT=500ms
FUNTRANSLATIONS_CB_SLIDING_WINDOW_SIZE=10
FUNTRANSLATIONS_CB_FAILURE_RATE_THRESHOLD=50
FUNTRANSLATIONS_CB_WAIT_OPEN=60s

# Actuator
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
